{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(./scripts/kanban.sh:*)",
      "Bash(scripts/kanban.sh:*)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm test:*)",
      "Bash(npm run dev)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- .)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
